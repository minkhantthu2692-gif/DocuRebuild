{
  "name": "docurebuild",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI-powered document reconstruction workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @docurebuild/web",
    "dev:api": "python -m uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "build": "npm run build -w @docurebuild/web",
    "typecheck": "npm run typecheck -w @docurebuild/web",
    "test": "npm run test:web && npm run test:api",
    "test:web": "npm run test -w @docurebuild/web",
    "test:api": "python -m pytest backend/tests -q",
    "lint": "npm run lint -w @docurebuild/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}

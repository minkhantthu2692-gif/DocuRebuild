# ---------------------------------------------------------------------------
# DocuRebuild .gitignore
# Application source code is committed. User data is NEVER committed.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
# The desktop shell keeps its installer artwork in a build folder that must be
# committed; only generated build output is ignored.
!apps/desktop/build/
!apps/desktop/build/*

# Local environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
# Encrypted AI provider key store (normally inside the data folder).
*.enc

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# Local application data and user project data (Category C - never pushed)
# These are anchored to the repository root on purpose. An unanchored
# `projects/` would also ignore source folders such as
# `apps/web/src/components/projects/`, which must be committed. If you point
# DOCUREBUILD_DATA_DIR inside this repository somewhere else, add that folder
# to this file before running the app.
/data/
/.data/
/user-data/
/projects/
/backups/
/exports/
/thumbnails/
/cache/
/.trash/
# OCR accuracy fixtures hold real page images and their transcripts.
/backend/ocr-fixtures/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# Test artefacts
test-results/
playwright-report/
playwright/.cache/
coverage/

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

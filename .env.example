# Copy to backend/.env for local development.
# All values are optional; safe defaults are used when omitted.

# Root folder for the application database and user projects.
# Default: <OS application data>/DocuRebuild
# DOCUREBUILD_DATA_DIR=C:/Users/you/DocuRebuildData

# Additional allowed browser origins (JSON array) for the local API.
# DOCUREBUILD_CORS_ORIGINS=["http://localhost:5173"]

# Maximum size of a single imported file, in megabytes.
# DOCUREBUILD_MAX_IMPORT_MB=200

# Files per import batch.
# DOCUREBUILD_MAX_UPLOAD_BATCH=50

# Local PDF rendering (PyMuPDF, no external service).
# Pages are rendered at this DPI when imported and when rotated.
# DOCUREBUILD_PDF_RENDER_DPI=150
# Maximum pages accepted from one PDF file.
# DOCUREBUILD_PDF_MAX_PAGES=1000

# Source repository shown in the About section (optional).
# DOCUREBUILD_REPOSITORY_URL=https://github.com/owner/repo

# Local OCR with Tesseract (optional; OCR stays unavailable until this works).
# Quote paths that contain spaces.
# DOCUREBUILD_TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
# DOCUREBUILD_TESSDATA_DIR="C:/Program Files/Tesseract-OCR/tessdata"
# DOCUREBUILD_OCR_TIMEOUT_SECONDS=180
# DOCUREBUILD_OCR_MAX_IMAGE_EDGE=4000
# DOCUREBUILD_OCR_MAX_WORKERS=2

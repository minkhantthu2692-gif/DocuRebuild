# Copy to backend/.env for local development.
# All values are optional; safe defaults are used when omitted.

# Root folder for the application database and user projects.
# Default: <OS application data>/DocuRebuild
# DOCUREBUILD_DATA_DIR=C:/Users/you/DocuRebuildData

# Additional allowed browser origins (JSON array) for the local API.
# DOCUREBUILD_CORS_ORIGINS=["http://localhost:5173"]

# Maximum size of a single imported file, in megabytes.
# DOCUREBUILD_MAX_IMPORT_MB=200

# Source repository shown in the About section (optional).
# DOCUREBUILD_REPOSITORY_URL=https://github.com/owner/repo
